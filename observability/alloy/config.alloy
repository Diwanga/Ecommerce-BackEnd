  }]
  forward_to      = [prometheus.remote_write.default.receiver]
  scrape_interval = "15s"
  metrics_path    = "/actuator/prometheus"
}

prometheus.scrape "payment_service" {
  targets = [{
    __address__ = "payment-service:8082",
