logging {
  level  = "info"
  format = "logfmt"
}

prometheus.scrape "eureka_server" {
  targets = [{
    __address__ = "eureka-server:8761",
    job         = "eureka-server",
  }]
  forward_to      = [prometheus.remote_write.default.receiver]
  scrape_interval = "15s"
  metrics_path    = "/actuator/prometheus"
}

prometheus.scrape "api_gateway" {
  targets = [{
    __address__ = "api-gateway:8060",
    job         = "api-gateway",
  }]
  forward_to      = [prometheus.remote_write.default.receiver]
  scrape_interval = "15s"
  metrics_path    = "/actuator/prometheus"
}

prometheus.scrape "order_service" {
  targets = [{
    __address__ = "order-service:8081",
