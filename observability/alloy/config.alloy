  }]
  forward_to      = [prometheus.remote_write.default.receiver]
  scrape_interval = "15s"
  metrics_path    = "/actuator/prometheus"
}

prometheus.scrape "inventory_service_1" {
  targets = [{
    __address__ = "inventory-service-1:8083",
