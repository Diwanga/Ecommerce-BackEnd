// ============================================
// LOGGING CONFIGURATION
// ============================================

logging {
  level  = "info"
  format = "logfmt"
}

// ============================================
// METRICS SCRAPING (Prometheus)
// ============================================

// Scrape metrics from Eureka Server
prometheus.scrape "eureka_server" {
  targets = [{
    __address__ = "eureka-server:8761",
    job         = "eureka-server",
  }]

  forward_to      = [prometheus.remote_write.default.receiver]
  scrape_interval = "15s"
  metrics_path    = "/actuator/prometheus"
}

// Scrape metrics from API Gateway
prometheus.scrape "api_gateway" {
  targets = [{
    __address__ = "api-gateway:8060",
    job         = "api-gateway",
  }]

  forward_to      = [prometheus.remote_write.default.receiver]
  scrape_interval = "15s"
  metrics_path    = "/actuator/prometheus"
}

// Scrape metrics from Order Service
prometheus.scrape "order_service" {
  targets = [{
    __address__ = "order-service:8081",
    job         = "order-service",
  }]

  forward_to      = [prometheus.remote_write.default.receiver]
  scrape_interval = "15s"
  metrics_path    = "/actuator/prometheus"
}

// Scrape metrics from Payment Service
prometheus.scrape "payment_service" {
  targets = [{
    __address__ = "payment-service:8082",
    job         = "payment-service",
  }]

  forward_to      = [prometheus.remote_write.default.receiver]
  scrape_interval = "15s"
  metrics_path    = "/actuator/prometheus"
}

// Inventory Services
prometheus.scrape "inventory_service_1" {
  targets = [{
    __address__ = "inventory-service-1:8083",
    job         = "inventory-service",
    instance    = "1",
  }]
  forward_to = [prometheus.remote_write.default.receiver]
  scrape_interval = "15s"
  metrics_path = "/actuator/prometheus"
}

prometheus.scrape "inventory_service_2" {
  targets = [{
    __address__ = "inventory-service-2:8083",
    job         = "inventory-service",
    instance    = "2",
  }]
  forward_to = [prometheus.remote_write.default.receiver]
  scrape_interval = "15s"
  metrics_path = "/actuator/prometheus"
}

prometheus.scrape "inventory_service_3" {
  targets = [{
    __address__ = "inventory-service-3:8083",
    job         = "inventory-service",
    instance    = "3",
  }]
  forward_to = [prometheus.remote_write.default.receiver]
  scrape_interval = "15s"
  metrics_path = "/actuator/prometheus"
}

// Saga Orchestrator
prometheus.scrape "saga_orchestrator" {
  targets = [{
    __address__ = "saga-orchestrator:8085",
    job         = "saga-orchestrator",
  }]
  forward_to = [prometheus.remote_write.default.receiver]
  scrape_interval = "15s"
  metrics_path = "/actuator/prometheus"
}

// Notification Service
prometheus.scrape "notification_service" {
  targets = [{
    __address__ = "notification-service:8084",
    job         = "notification-service",
  }]
  forward_to = [prometheus.remote_write.default.receiver]
  scrape_interval = "15s"
  metrics_path = "/actuator/prometheus"
}

// ============================================
// PROMETHEUS REMOTE WRITE
// ============================================

prometheus.remote_write "default" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

 // ============================================
 // DOCKER LOGS → LOKI  (Alloy Static Mode)
 // ============================================

 // Discover docker containers
 discovery.docker "containers" {
   host = "unix:///var/run/docker.sock"
 }

 // Read docker logs
 loki.source.docker "containers" {
   host    = "unix:///var/run/docker.sock"
   targets = discovery.docker.containers.targets

   forward_to = [loki.process.raw.receiver]
 }

 // No label extraction (Static Mode cannot do it)
 loki.process "raw" {
   forward_to = [loki.write.default.receiver]
 }

 // Write logs to Loki
 loki.write "default" {
   endpoint {
     url       = "http://loki:3100/loki/api/v1/push"
     tenant_id = "docker"
   }
 }


// ============================================
// ALLOY SELF-MONITORING
// ============================================

prometheus.exporter.self "alloy" { }

prometheus.scrape "alloy" {
  targets    = prometheus.exporter.self.alloy.targets
  forward_to = [prometheus.remote_write.default.receiver]
  job_name   = "alloy"
}
