{
  "dashboard": {
    "title": "Resilience4j Patterns",
    "tags": ["resilience4j", "circuit-breaker", "retry"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 0,
    "refresh": "5s",
    "panels": [
      {
        "id": 1,
        "title": "Circuit Breaker States",
        "type": "stat",
        "gridPos": {"h": 6, "w": 8, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "resilience4j_circuitbreaker_state{job=~\"payment-service|inventory-service|api-gateway\"}",
            "legendFormat": "{{job}} - {{name}} - {{state}}",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "none"
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 1},
                {"color": "red", "value": 2}
              ]
            },
            "mappings": [
              {"type": "value", "value": "0", "text": "CLOSED"},
              {"type": "value", "value": "1", "text": "HALF_OPEN"},
              {"type": "value", "value": "2", "text": "OPEN"}
            ]
          }
        }
      },
      {
        "id": 2,
        "title": "Circuit Breaker Failure Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
        "targets": [
          {
            "expr": "resilience4j_circuitbreaker_failure_rate{job=~\"payment-service|inventory-service|api-gateway\"}",
            "legendFormat": "{{job}} - {{name}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "max": 100,
            "min": 0
          }
        }
      },
      {
        "id": 3,
        "title": "Circuit Breaker Call Outcomes",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
        "targets": [
          {
            "expr": "rate(resilience4j_circuitbreaker_calls_seconds_count{job=~\"payment-service|inventory-service|api-gateway\"}[1m])",
            "legendFormat": "{{job}} - {{name}} - {{kind}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops"
          }
        }
      },
      {
        "id": 4,
        "title": "Retry Attempts",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
        "targets": [
          {
            "expr": "rate(resilience4j_retry_calls_seconds_count{job=~\"payment-service|inventory-service|order-service\"}[1m])",
            "legendFormat": "{{job}} - {{name}} - {{kind}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 5,
        "title": "Rate Limiter - Available Permissions",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14},
        "targets": [
          {
            "expr": "resilience4j_ratelimiter_available_permissions{job=~\"payment-service|api-gateway\"}",
            "legendFormat": "{{job}} - {{name}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 6,
        "title": "Bulkhead - Available Concurrent Calls",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 22},
        "targets": [
          {
            "expr": "resilience4j_bulkhead_available_concurrent_calls{job=\"inventory-service\"}",
            "legendFormat": "{{instance}} - {{name}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 7,
        "title": "Bulkhead - Max Allowed Concurrent Calls",
        "type": "stat",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 22},
        "targets": [
          {
            "expr": "resilience4j_bulkhead_max_allowed_concurrent_calls{job=\"inventory-service\"}",
            "legendFormat": "{{instance}} - {{name}}",
            "refId": "A"
          }
        ]
      }
    ]
  },
  "overwrite": true
}